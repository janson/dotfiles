[user]
  name = Janson Hartliep
  email = janson@fastmail.fm
[color]
  ui = always
  diff = auto
  status = auto
[alias]
  a = !git add --patch && git status
  b = branch -avv
  c = commit -a
  d = log --diff-filter=D -- $1
  di = diff --cached
  l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset %C(cyan)%G? %GK%Creset'
  ll = log --stat --abbrev-commit
  in = !git fetch && git log --pretty=oneline --abbrev-commit ..@{u} 
  out = log --pretty=oneline --abbrev-commit @{u}..
  publish = push --tags origin :
  s = status -sb
  t = log --tags --simplify-by-decoration --pretty=format:'%ai%C(cyan)%d %C(yellow)%h %Creset%s %C(white)%an'
  refresh = !git fetch --all && git remote prune origin && git checkout main && git pull
	stale-branches = !git fetch -p && git branch -vv | grep \"origin/.*: gone]\" | awk \"{print \\$1}\"
[commit]
	gpgsign = true
	template = ~/.gitmessage
[mergetool]
  keepBackup = false
	prompt = false
[merge]
  log = true
	tool = Kaleidoscope
	conflictstyle = zdiff3
[branch]
  autosetuprebase = local
[init]
  defaultBranch = main
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
[diff]
	tool = Kaleidoscope
[status]
  submoduleSummary = true
[core]
	whitespace = trailing-space
	editor = nvim -f
  pager = delta
	ignorecase = false
[apply]
	whitespace = fix
[credential]
	helper = osxkeychain
[delta]
    features = decorations
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[tag]
	gpgSign = true

# Machine-specific settings (signingkey, work email); not tracked.
[include]
	path = ~/.gitconfig.local
