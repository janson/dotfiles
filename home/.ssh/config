# Adapted from https://github.com/drduh/config/blob/main/ssh_config
# Lists below are from `ssh -Q cipher|mac|kex|key`; drop one if a host can't connect.

Host github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  UseKeychain yes

Host *
  HashKnownHosts yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  ServerAliveInterval 300
  ServerAliveCountMax 2
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
  KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com,curve25519-sha256,diffie-hellman-group16-sha512
  HostKeyAlgorithms ssh-ed25519,rsa-sha2-512,rsa-sha2-256
